extends base

mixin navItem(link, text, icon, active, target)
  li(class=`${active ? 'side-nav--active' : ''}`)
    a.nav-tab(href=link, data-tab=target)
      svg
        use(xlink:href=`img/icons.svg#icon-${icon}`)
      | #{text}

block content
  main.main
    .user-view
      nav.user-view__menu
        ul.side-nav
          +navItem('#', 'Settings', 'settings', true, 'settings')
          +navItem('#', 'My bookings', 'briefcase', false, 'bookings')
          +navItem('#', 'My reviews', 'star', false, 'reviews')
          +navItem('#', 'Billing', 'credit-card', false, 'billing')

        - if (user.role === 'admin')
          .admin-nav
            h5.admin-nav__heading Admin
            ul.side-nav
              +navItem('#', 'Manage tours', 'map', false, '')
              +navItem('#', 'Manage users', 'users', false, '')
              +navItem('#', 'Manage reviews', 'star', false, '')
              +navItem('#', 'Manage bookings', 'briefcase', false, '')

      .user-view__content
        #settings-tab.tab-content
          .user-view__form-container
            h2.heading-secondary.ma-bt-md Your account settings
            form.form.form-user-data
              .form__group
                label.form__label(for='name') Name
                input#name.form__input(type='text', value=user.name, required, name='name')
              .form__group.ma-bt-md
                label.form__label(for='email') Email address
                input#email.form__input(type='email', value=user.email, required, name='email')
              .form__group.form__photo-upload
                img.form__user-photo(src=`/img/users/${user.photo}`, alt='User photo')
                input#photo.form__upload(type="file" name="photo" accept="image/*")
                label.btn-text(for="photo") Choose new photo
              .form__group.right
                button.btn.btn--small.btn--green(type='submit') Save settings

          .line &nbsp;
          
          .user-view__form-container
            h2.heading-secondary.ma-bt-md Password change
            form.form.form-user-password
              .form__group
                label.form__label(for='password-current') Current password
                input#password-current.form__input(type='password', placeholder='••••••••', required, minlength='8')
              .form__group
                label.form__label(for='password') New password
                input#password.form__input(type='password', placeholder='••••••••', required, minlength='8')
              .form__group.ma-bt-lg
                label.form__label(for='password-confirm') Confirm password
                input#password-confirm.form__input(type='password', placeholder='••••••••', required, minlength='8')
              .form__group.right
                button.btn.btn--small.btn--green.btn--save-password(type='submit') Update password

        #bookings-tab.tab-content(style='display: none;')
          .user-view__form-container
            h2.heading-secondary.ma-bt-md My bookings
            #bookings-list
              p.loading-text Loading...

        #reviews-tab.tab-content(style='display: none;')
          .user-view__form-container
            h2.heading-secondary.ma-bt-md My reviews
            #reviews-list
              p.loading-text Loading...

        #billing-tab.tab-content(style='display: none;')
          .user-view__form-container
            h2.heading-secondary.ma-bt-md Billing & payments
            #billing-list
              p.loading-text Loading...
