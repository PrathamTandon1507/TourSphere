NODE_ENV=development
PORT=8000

# MongoDB
DATABASE=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
DATABASE_PASSWORD=<your-db-password>

# Auth
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# Frontend URL used in auth/checkout redirects
FRONTEND_URL=http://localhost:5173

# Payments
CLIENT_ID=your-phonepe-client-id
CLIENT_KEY_SECRET=your-phonepe-client-key-secret

# Email (primary)
EMAIL_FROM="Natours <no-reply@example.com>"
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Brevo SMTP (optional alternative)
BREVO_HOST=
BREVO_PORT=587
BREVO_LOGIN=
BREVO_PASSWORD=
